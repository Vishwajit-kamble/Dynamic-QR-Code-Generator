# TapReview Backend Environment Configuration Example
FLASK_ENV=development
PORT=5000
SECRET_KEY=change_this_to_a_random_32_byte_secret_key_in_production
TIMEZONE=Asia/Kolkata

# Admin Credentials (Initial setup / private single-admin access)
ADMIN_EMAIL=admin@tapreview.com
ADMIN_PASSWORD=AdminTapReview2026!

# Public Domain / Base URL for redirect slugs
# Example: https://tapreview.io (Do not add trailing slash)
PUBLIC_REDIRECT_BASE_URL=http://localhost:5000

# Supabase Credentials (Optional for local SQLite development, required for production Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Storage paths
QR_OUTPUT_DIR=../qr_codes
PRODUCTION_EXPORTS_DIR=../production_exports

